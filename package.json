{
  "name": "stu-trade-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "api:check": "openapi-typescript openapi/stu-trade.yaml --output src/api/generated/schema.ts --check",
    "api:generate": "openapi-typescript openapi/stu-trade.yaml --output src/api/generated/schema.ts",
    "api:lint": "redocly lint openapi/stu-trade.yaml",
    "msw:check": "cmp -s public/mockServiceWorker.js node_modules/msw/lib/mockServiceWorker.js || (echo 'public/mockServiceWorker.js is out of sync with the locked MSW package.' >&2; exit 1)",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "bun run api:lint && bun run api:check && bun run msw:check && bun run lint && bun run test && bun run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@redocly/cli": "2.53.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
